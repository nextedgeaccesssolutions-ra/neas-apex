FROM node:22-bookworm-slim
ENV CHROME_PATH=/usr/bin/chromium
RUN apt-get update && apt-get install -y --no-install-recommends chromium ca-certificates fonts-liberation libasound2 libatk-bridge2.0-0 libatk1.0-0 libc6 libcairo2 libcups2 libdbus-1-3 libdrm2 libexpat1 libgbm1 libglib2.0-0 libgtk-3-0 libnspr4 libnss3 libpango-1.0-0 libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 xdg-utils && rm -rf /var/lib/apt/lists/*
RUN npm install --global lighthouse@12.8.2
RUN groupadd --system --gid 1001 lighthouse && useradd --system --uid 1001 --gid lighthouse --create-home lighthouse && mkdir -p /reports && chown lighthouse:lighthouse /reports
USER lighthouse
WORKDIR /reports
ENTRYPOINT ["lighthouse"]
